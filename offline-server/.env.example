# Configuration du serveur hors-ligne (offline-server)
# Copiez ce fichier en .env dans ce meme dossier : cp .env.example .env

# Port d'ecoute du serveur local de secours (par defaut 3500)
PORT=3500

# Cle secrete utilisee pour signer les sessions JWT locales.
# Mettez une longue chaine aleatoire differente de celle du site en ligne.
JWT_SECRET="changez-moi-avec-une-longue-chaine-aleatoire-locale-32-caracteres-min"

# Code d'acces secret pour la connexion admin en local (identique ou different
# de celui du site en ligne, au choix de la bibliotheque).
ADMIN_ACCESS_CODE="ESPA2A"

# Adresse du site en ligne, utilisee pour detecter le retour d'Internet et
# synchroniser automatiquement les emprunts/utilisateurs enregistres hors-ligne.
# Doit correspondre a NEXT_PUBLIC_SITE_URL du site principal.
NEXT_PUBLIC_SITE_URL="https://catalogue-plus.vercel.app"

# Cle partagee entre le serveur offline et les routes /api/sync/* du site en
# ligne, pour verifier que les requetes de synchronisation sont legitimes.
# Doit avoir exactement la meme valeur que SYNC_SECRET cote site en ligne.
SYNC_SECRET="changez-moi-cle-partagee-de-synchronisation"
